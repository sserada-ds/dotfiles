#!/usr/bin/env bash
# 機密情報 (トークン・鍵・パスワード) の混入チェック
#
#   secret-scan --staged           ステージ済みの追加行をスキャン (pre-commit 用)
#   secret-scan --stdin [LABEL]    標準入力のテキストをスキャン (Claude Code hook 用)
#
# 終了コード: 0=問題なし / 1=検出あり
# 検出した値そのものは表示しない (ファイル名・行番号・ルール名のみ)
#
# 例外: 行内に "allow-secret" を含めるとその行は無視される
#       どうしても通したいときは git commit --no-verify

set -uo pipefail

TAB=$'\t'

# "ルール名<TAB>正規表現" (grep -E)
PATTERNS=(
  "AWS アクセスキー${TAB}AKIA[0-9A-Z]{16}"
  "GitHub トークン${TAB}gh[pousr]_[A-Za-z0-9]{36,}"
  "GitHub PAT${TAB}github_pat_[A-Za-z0-9_]{50,}"
  "Langfuse キー${TAB}[sp]k-lf-[0-9a-fA-F-]{20,}"
  "Anthropic API キー${TAB}sk-ant-[A-Za-z0-9_-]{20,}"
  "OpenAI API キー${TAB}sk-(proj-)?[A-Za-z0-9_-]{32,}"
  "Slack トークン${TAB}xox[baprs]-[A-Za-z0-9-]{10,}"
  "Google API キー${TAB}AIza[0-9A-Za-z_-]{35}"
  "秘密鍵${TAB}-----BEGIN ([A-Z]+ )?PRIVATE KEY-----"
  "認証情報の直書き${TAB}(password|passwd|secret|token|api[_-]?key|access[_-]?key)[\"']?[[:space:]]*[=:][[:space:]]*[\"']?[A-Za-z0-9/+_=.-]{16,}"
)

# 誤検知を避けるためのプレースホルダー表現 (認証情報の直書きルールにのみ適用)
PLACEHOLDER='(example|sample|placeholder|your[_-]|xxxx|changeme|dummy|<[^>]+>|\$\{|\$\(|\*{4,}|\.\.\.)'

# ステージ済みファイルのうち、ファイル名自体が危険なもの
DANGEROUS_FILES='(^|/)(\.env(\.[a-z0-9_-]+)?|id_(rsa|dsa|ecdsa|ed25519)|credentials|\.netrc|\.pgpass)$|\.(pem|p12|pfx|key)$'
SAFE_FILES='\.(example|sample|template)$'

found=0

# 入力: "file:line:content" の行。出力: 検出箇所 (内容は出さない)
scan_records() {
  local records="$1" entry name re hits
  for entry in "${PATTERNS[@]}"; do
    name="${entry%%${TAB}*}"
    re="${entry#*${TAB}}"
    hits="$(printf '%s\n' "$records" | grep -E -e "$re" | grep -v 'allow-secret' || true)"
    if [[ "$name" == "認証情報の直書き" ]]; then
      hits="$(printf '%s\n' "$hits" | grep -viE "$PLACEHOLDER" || true)"
    fi
    [[ -z "$hits" ]] && continue
    printf '%s\n' "$hits" | cut -d: -f1,2 | sort -u | while IFS= read -r loc; do
      printf '  ✗ %s  [%s]\n' "$loc" "$name" >&2
    done
    found=1
  done
}

scan_staged() {
  git rev-parse --git-dir >/dev/null 2>&1 || return 0

  # 1) ファイル名チェック
  local f
  while IFS= read -r f; do
    [[ -z "$f" ]] && continue
    if [[ "$f" =~ $DANGEROUS_FILES ]] && ! [[ "$f" =~ $SAFE_FILES ]]; then
      printf '  ✗ %s  [機密ファイルの可能性]\n' "$f" >&2
      found=1
    fi
  done < <(git diff --cached --name-only --diff-filter=ACMR)

  # 2) 追加行の内容チェック
  local records
  records="$(
    git diff --cached --no-color -U0 --diff-filter=ACMR | awk '
      /^\+\+\+ /{ file = ($0 == "+++ /dev/null") ? "" : substr($0, 7); next }
      /^@@/{ match($0, /\+[0-9]+/); line = substr($0, RSTART + 1, RLENGTH - 1) + 0; next }
      /^\+/{ if (file != "") printf "%s:%d:%s\n", file, line, substr($0, 2); line++ }
    '
  )"
  [[ -n "$records" ]] && scan_records "$records"

  # 3) gitleaks があれば追加で実行 (ルールが豊富。検出内容は --redact で伏せられる)
  if command -v gitleaks >/dev/null 2>&1; then
    local out rc
    out="$(gitleaks git --pre-commit --staged --redact --no-banner 2>&1)"
    rc=$?
    if [[ $rc -ne 0 && "$out" == *"unknown command"* ]]; then
      # gitleaks 8.18 以前
      out="$(gitleaks protect --staged --redact --no-banner 2>&1)"
      rc=$?
    fi
    if [[ $rc -ne 0 ]]; then
      printf '%s\n' "$out" >&2
      found=1
    fi
  else
    echo "  (gitleaks 未導入: 自前ルールのみで検査しました)" >&2
  fi
}

scan_stdin() {
  local label="${1:-stdin}" records
  records="$(awk -v f="$label" '{ printf "%s:%d:%s\n", f, NR, $0 }')"
  [[ -n "$records" ]] && scan_records "$records"
}

case "${1:-}" in
--staged) scan_staged ;;
--stdin) scan_stdin "${2:-stdin}" ;;
*)
  echo "usage: secret-scan --staged | --stdin [LABEL]" >&2
  exit 2
  ;;
esac

if [[ "$found" -ne 0 ]]; then
  {
    echo ""
    echo "機密情報の可能性がある内容を検出しました。値は表示していません。"
    echo "  - 本物なら: 該当箇所を削除し、環境変数や .env (git管理外) に移してください"
    echo "  - 本物のキーを一度でもコミット/pushしたなら: 発行元でキーを失効・再発行してください"
    echo "  - 誤検知なら: その行に 'allow-secret' を含めるか、git commit --no-verify"
  } >&2
  exit 1
fi
exit 0
