# ========== OS生成ファイル ==========
# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
.AppleDouble
.LSOverride

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
Desktop.ini

# Linux
*~
.directory

# ========== エディタ/IDE ==========
# Vim
*.swp
*.swo
*.swn
*~
.netrwhist

# VSCode
.vscode/
*.code-workspace

# JetBrains (IntelliJ, PyCharm, etc.)
.idea/
*.iml

# Sublime Text
*.sublime-project
*.sublime-workspace

# ========== 環境・機密ファイル ==========
.env
.env.local
.env.*.local
*.pem
*.key
credentials.json
secrets.json

# ========== 依存関係・ビルド ==========
node_modules/
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
*.egg-info/
dist/
build/
*.log

# ========== Claude Code ==========
# 個人用・ローカル専用のみ無視する
